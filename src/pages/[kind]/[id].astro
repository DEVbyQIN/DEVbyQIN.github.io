---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const entries = await getCollection('writing', ({data}) => !data.draft);
  return entries.map(entry => ({ params: { kind: entry.data.kind, id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const label = entry.data.kind === 'notes' ? '笔记' : '文章';
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="wrap article-page"><a class="back-link" href={`/${entry.data.kind}/`}>← 全部{label}</a><header class="article-heading"><div class="entry-meta">{entry.data.date.toISOString().slice(0,10).replaceAll('-', '.')} · {label}{entry.data.sample && <span class="sample-badge">排版示例</span>}</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="tags">{entry.data.tags.map(tag => <span>{tag}</span>)}</div></header>{entry.data.sample && <div class="sample-notice">这是一篇建站示例，用于展示内容排版，可随时替换为自己的文章或笔记。</div>}<div class="article-layout"><div class="prose"><Content/></div>{headings.length > 0 && <aside class="toc"><span class="eyebrow">ON THIS PAGE</span><nav aria-label="文章目录">{headings.filter(h=>h.depth < 4).map(h=><a class:list={[h.depth === 3 && 'toc-sub']} href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}</div><div class="article-end">✦<span>下一页，继续保持好奇。</span></div></article>
</Base>
